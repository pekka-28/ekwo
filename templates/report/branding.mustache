<header class="report-brand logo-{{branding.position}}"{{#branding.accent}} style="--report-accent:{{branding.accent}}"{{/branding.accent}}>
  {{#branding.logo}}<img src="{{branding.logo}}" alt="{{company}} logo">{{/branding.logo}}
  <div class="brand-text"><p>{{company}}</p><h1>{{title}}</h1><p>{{date}}</p></div>
</header>
