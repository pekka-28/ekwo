<article class="t-account"><h2>{{code}} · {{name}}</h2>
  <div class="t-head"><span>Debit</span><span>Credit</span></div><div class="t-sides">
    <div class="t-side">{{#debits}}{{> event}}{{/debits}}{{#debitCarry}}<div class="t-carry"><span>Balance c/f</span><span class="event-number">{{debitCarry}}</span></div>{{/debitCarry}}<div class="t-total"><span>Total</span><span class="event-number">{{debit}}</span></div></div>
    <div class="t-side">{{#credits}}{{> event}}{{/credits}}{{#creditCarry}}<div class="t-carry"><span>Balance c/f</span><span class="event-number">{{creditCarry}}</span></div>{{/creditCarry}}<div class="t-total"><span>Total</span><span class="event-number">{{credit}}</span></div></div>
  </div>
</article>
