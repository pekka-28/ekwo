{{#showJournal}}{{> journal}}{{/showJournal}}
{{#showTAccounts}}<p class="report-caption">Fragment 1 {{name}} account movements ({{currency}})</p><div class="report-account-group">{{#accounts}}{{> t-account}}{{/accounts}}</div>{{/showTAccounts}}
{{#showAccounts}}<p class="report-caption">Table {{table}} {{name}} accounts ({{currency}})</p>
<table class="report-accounts"><thead><tr><th>Code</th><th>Account</th><th class="event-number">Debit</th><th class="event-number">Credit</th><th class="event-number">Balance change</th></tr></thead>
<tbody>{{#accounts}}<tr><td>{{code}}</td><td>{{name}}</td><td class="event-number">{{debitMovement}}</td><td class="event-number">{{creditMovement}}</td><td class="event-number">{{change}}</td></tr>{{/accounts}}</tbody></table>{{/showAccounts}}
