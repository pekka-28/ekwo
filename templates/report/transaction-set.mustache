{{#showJournal}}{{> journal}}{{/showJournal}}
{{#showTAccounts}}<p class="report-caption">Fragment 1 {{name}} account movements ({{currency}})</p><div class="report-account-group">{{#accounts}}{{> t-account}}{{/accounts}}</div>{{/showTAccounts}}
{{#showAccounts}}<p class="report-caption">Table {{table}} {{name}} accounts ({{currency}})</p>
{{#showSummary}}<table class="report-accounts"><thead><tr><th>Code</th><th>Account</th><th class="event-number">Debit</th><th class="event-number">Credit</th><th class="event-number">Balance change</th></tr></thead>
<tbody>{{#accounts}}<tr><td>{{code}}</td><td>{{name}}</td><td class="event-number">{{debitMovement}}</td><td class="event-number">{{creditMovement}}</td><td class="event-number">{{change}}</td></tr>{{/accounts}}</tbody></table>{{/showSummary}}
{{#showDetail}}<table class="report-account-detail"><thead><tr><th>Date</th><th>Transaction</th><th>Reference</th><th>Description</th><th class="event-number">Debit</th><th class="event-number">Credit</th><th class="event-number">Running change</th></tr></thead>
{{#accounts}}<tbody><tr class="account-heading"><th colspan="7">{{code}} · {{name}}</th></tr>{{#movements}}<tr class="account-movement"><td>{{date}}</td><td>{{description}}</td><td>{{reference}}</td><td>{{lineDescription}}</td><td class="event-number">{{debit}}</td><td class="event-number">{{credit}}</td><td class="event-number">{{balance}}</td></tr>{{/movements}}<tr><th colspan="4">Total</th><td class="event-number">{{debitMovement}}</td><td class="event-number">{{creditMovement}}</td><td class="event-number">{{change}}</td></tr></tbody>{{/accounts}}</table>{{/showDetail}}{{/showAccounts}}
