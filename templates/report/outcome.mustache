{{^empty}}<p class="report-caption">Table {{table}} {{name}} outcome ({{currency}})</p>
<table class="report-outcome"><thead><tr><th>Account</th><th>Name</th><th class="event-number">Debit change</th><th class="event-number">Credit change</th></tr></thead>
<tbody>{{#rows}}<tr><td>{{code}}</td><td>{{name}}</td><td class="event-number">{{debit}}</td><td class="event-number">{{credit}}</td></tr>{{/rows}}</tbody></table>{{/empty}}
